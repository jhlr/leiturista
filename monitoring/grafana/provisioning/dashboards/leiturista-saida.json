          "sort": "none"
        }
      },
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "windowFunctions",
            "alias": "legivel (taxa)",
            "window": {
              "field": "legivel",
              "reducer": "mean",
              "windowAlignment": "trailing",
              "windowSize": 10,
              "windowSizeMode": "fixed"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "windowFunctions",
            "alias": "has_reading (taxa)",
            "window": {
              "field": "has_reading",
              "reducer": "mean",
              "windowAlignment": "trailing",
              "windowSize": 10,
              "windowSizeMode": "fixed"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "windowFunctions",
            "alias": "has_serial (taxa)",
            "window": {
              "field": "has_serial",
              "reducer": "mean",
              "windowAlignment": "trailing",
              "windowSize": 10,
              "windowSizeMode": "fixed"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|.* \\(taxa\\))$"
            }
          }
        }
      ],
