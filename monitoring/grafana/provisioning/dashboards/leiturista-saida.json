      "description": "Box plot do intervalo do dashboard (azul) contra a referência (cinza): caixa Q1 a Q3, traço na mediana, bigodes no mínimo e no máximo. Painel Business Charts (ECharts, volkovlabs-echarts-panel 7.2.5) alimentado por /data/summary via Infinity.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "options": {
        "renderer": "canvas",
        "editorMode": "code",
        "getOption": "const s = context.panel.data.series[0];if (!s) { return {}; }const col = (n) => { const f = s.fields.find((x) => x.name === n); return f ? Array.from(f.values) : []; };const ink = (context.grafana && context.grafana.theme && context.grafana.theme.colors.text.primary) || '#aaa';const names = col('variavel');const box = (p) => names.map((_, i) => [col(p + '_min')[i], col(p + '_q1')[i], col(p + '_median')[i], col(p + '_q3')[i], col(p + '_max')[i]]);return { textStyle: { color: ink }, tooltip: { trigger: 'item', confine: true }, legend: { data: ['Janela', 'Referência'], textStyle: { color: ink } }, grid: { left: 90, right: 20, top: 40, bottom: 30 }, xAxis: { type: 'category', data: names, axisLabel: { color: ink } }, yAxis: { type: 'value', scale: true, axisLabel: { color: ink }, splitLine: { lineStyle: { opacity: 0.2 } } }, series: [  { name: 'Janela', type: 'boxplot', data: box('w'), itemStyle: { color: 'rgba(61,133,222,0.35)', borderColor: '#3d85de' } },  { name: 'Referência', type: 'boxplot', data: box('r'), itemStyle: { color: 'rgba(150,150,150,0.35)', borderColor: '#8a8a8a' } } ] };",
        "editor": {
          "language": "javascript",
          "format": "auto"
        },
        "visualEditor": {
          "dataset": [],
          "series": [],
          "code": ""
        },
        "map": "none",
        "themeEditor": {
          "name": "default",
          "config": "{}"
        }
      },
