// Grafana Alloy (E1): le o arquivo de log do servico e manda as linhas para o Loki.
// O Loki guarda logs mas nao le arquivos; um coletor (aqui o Alloy) le o arquivo e envia as linhas.
// Rotulos so `job` e `event` (nunca status, request_id, variaveis ou latencia).

// Arquivo ativo e rotacionados (inference.log, inference.log.1 ... .5), montados somente leitura.
local.file_match "serving" {
  path_targets = [{"__path__" = "/serving-logs/inference.log*", "job" = "leiturista"}]
  sync_period  = "5s"
}

loki.source.file "serving" {
  targets    = local.file_match.serving.targets
  forward_to = [loki.process.serving.receiver]
}

loki.process "serving" {
  // cada linha e um objeto JSON; `event` (request | response) vira rotulo
  stage.json {
    expressions = {event = "event", ts = "ts"}
  }
  // O instante do evento vem do proprio log (`ts`), nao do momento da leitura. Assim reler uma linha (os arquivos
  // rotacionados mudam de nome e o Alloy guarda a posicao por caminho) gera a MESMA entrada (stream, instante, texto),
  // e o Loki descarta entradas identicas: nao ha duplicata.
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = {event = ""}
  }
  // loki.source.file poe o caminho no rotulo `filename`; fora dele, o stream nao depende do arquivo
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
